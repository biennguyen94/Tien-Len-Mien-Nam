# Copy to deploy/.env (gitignored) and fill in.

# Required: generate with `mix phx.gen.secret` (64+ random bytes). Never commit it.
SECRET_KEY_BASE=

# Required: password of the tien_len PostgreSQL user (any long random string, e.g.
# `openssl rand -hex 24`). The compose file builds DATABASE_URL from it. Changing it later
# requires changing it inside the database too (the volume keeps the first password).
POSTGRES_PASSWORD=

# Optional: database pool size
# POOL_SIZE=10

# Public address of the site (used for absolute links such as "Chơi tiếp trên máy khác").
PHX_HOST=localhost
PHX_URL_SCHEME=http
PHX_URL_PORT=4020
# Behind an HTTPS reverse proxy: PHX_URL_SCHEME=https, PHX_URL_PORT=443 (see docs/DEPLOY.md).
# force_ssl is already compiled in from config/prod.exs; PHX_FORCE_SSL is not needed.

# Host port published by docker compose (compose variable, not read by the app)
WEB_PORT=4020

# Count failed logins per IP too (F8). On the WSL Docker deploy every browser arrives from the
# Docker gateway address, so IP counting would let one person block everyone: keep it false
# there; enable it behind a proxy that passes the real client IP.
THROTTLE_BY_IP=false

# Maximum number of open rooms (spam guard; admins can change it on the web)
MAX_ROOMS=500
