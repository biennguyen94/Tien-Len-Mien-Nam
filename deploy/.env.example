# Copy to deploy/.env (gitignored) and fill in.

# Required: generate with `mix phx.gen.secret` (64+ random bytes). Never commit it.
SECRET_KEY_BASE=

# Public address of the site (used for absolute links such as "Chơi tiếp trên máy khác").
PHX_HOST=localhost
PHX_URL_SCHEME=http
PHX_URL_PORT=4020
# Behind an HTTPS reverse proxy: PHX_URL_SCHEME=https, PHX_URL_PORT=443, PHX_FORCE_SSL=true
# PHX_FORCE_SSL=false

# Host port published by docker compose (compose variable, not read by the app)
WEB_PORT=4020

# Maximum number of open rooms (spam guard)
MAX_ROOMS=500
